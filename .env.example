# Copy to .env.local and fill in. Never commit real values.
# OpenRouter key for the chatbot LLM (server-side only).
OPENROUTER_API_KEY=

# Supabase (handoffs table). Injected by the Vercel Marketplace integration;
# locally, `npx vercel env pull .env.local`. Server-side only: the secret key
# bypasses RLS and must never get a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used only by scripts/verify-handoff.mjs, to prove the public key can't read handoffs.
SUPABASE_PUBLISHABLE_KEY=
